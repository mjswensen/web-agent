{
	"name": "web-agent",
	"image": "node",
	"build": { "dockerfile": "./Dockerfile" },
	"remoteUser": "node",
	"postCreateCommand": {
		"install": "npm install",
		"install-pi": "curl -fsSL https://pi.dev/install.sh | sh",
		"playwright": "sudo npx playwright install-deps && npx playwright install"
	},
	"appPort": ["0.0.0.0:5100:5100"]
}
