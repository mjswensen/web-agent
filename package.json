{
	"name": "@mjswensen/web-agent",
	"private": false,
	"version": "1.4.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"bin": {
		"web-agent": "./build/server/server/entry.js"
	},
	"files": [
		"build",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "bun --watch src/server/entry.ts",
		"dev:client": "bun --bun vite dev --host 0.0.0.0 --port 5100",
		"build": "bun --bun vite build && bun --bun tsc -p tsconfig.server.json && bun run scripts/prepare-package.ts",
		"prepack": "bun run precommit && bun run build",
		"start": "bun build/server/server/entry.js",
		"precommit": "bun run build && bun run check && bun run lint && bun run test && echo '\nprecommit OK ✅'",
		"preview": "bun build/server/server/entry.js",
		"check": "bun --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun --bun prettier --check . && bun --bun eslint .",
		"format": "bun --bun prettier --write .",
		"test:unit": "bun --bun vitest --run",
		"test:unit:watch": "bun --bun vitest",
		"test": "bun run test:unit && bun run test:e2e",
		"test:e2e": "bun --bun playwright install && bun --bun playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "1.3.14",
		"@types/markdown-it": "^14.1.2",
		"@types/sanitize-html": "^2.16.1",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.82.1",
		"markdown-it": "^14.3.0",
		"sanitize-html": "^2.17.6"
	}
}
