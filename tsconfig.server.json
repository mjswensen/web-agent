{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "./src",
		"outDir": "./build/server-runtime",
		"noEmit": false,
		"verbatimModuleSyntax": false,
		"declaration": false,
		"sourceMap": false,
		"allowJs": false,
		"checkJs": false
	},
	"include": ["src/server/**/*.ts", "src/lib/client/protocol.ts"],
	"exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/server/vite-websocket.ts"]
}
